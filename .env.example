# --- Postgres (used by the postgres service and by the backend) ---
POSTGRES_USER=netracare
POSTGRES_PASSWORD=netracare
POSTGRES_DB=netracare

# --- Backend ---
# Inside Docker, docker-compose.yml sets DATABASE_URL to the compose service.
# For local dev without Docker, point this at your own Postgres instance,
# e.g. postgresql+psycopg://netracare:netracare@localhost:5432/netracare
DATABASE_URL=postgresql+psycopg://netracare:netracare@localhost:5432/netracare
DATA_DIR=/app/data/data-pack-01

# Fixed clock for stretch-goal rule tests. Leave empty to use real time.
# Format: ISO 8601, e.g. 2026-11-02T10:00:00
CLINIC_NOW=

# --- LLM (Iteration 2) ---
# Provider is swappable via LLM_PROVIDER; each provider has its own API key env var.
# Defaults: Anthropic Claude Haiku 4.5 for fast chains (red-flag, Fact of the Day),
#           Sonnet 4.6 for quality chains (doctor summary).
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_QUALITY=claude-sonnet-4-6
# Per-chain timeouts in seconds. Red-flag fails closed on timeout; Fact/summary fall back.
LLM_TIMEOUT_FAST=5
LLM_TIMEOUT_QUALITY=8
# Token budgets (hard ceilings; chain fails if prompt assembly would exceed them).
LLM_MAX_TOKENS_RED_FLAG=2000
LLM_MAX_TOKENS_FACT=3000
LLM_MAX_TOKENS_SUMMARY=4000

# --- Local Ollama (used when LLM_PROVIDER=ollama) ---
# To use Ollama instead of Anthropic:
#   1. Pull the model:   ollama pull gpt-oss:20b   (13 GB; served from the host)
#   2. Set LLM_PROVIDER=ollama above
#   3. Raise timeouts to cover the cold model load on the first call:
#        LLM_TIMEOUT_FAST=30, LLM_TIMEOUT_QUALITY=120
# host.docker.internal works on Docker Desktop and recent Colima.
# Smaller models (e.g. qwen3:8b) are faster but returned schema-invalid
# red-flag output in spike testing; gpt-oss:20b was reliable 5/5 on the
# brief §09 samples. Switch at your own risk — the fail-closed path will
# refuse every booking if red-flag output is malformed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_FAST=gpt-oss:20b
OLLAMA_MODEL_QUALITY=gpt-oss:20b

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
